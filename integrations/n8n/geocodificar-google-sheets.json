      },
      "id": "f406c510-3646-4f33-847d-36d642fa6531",
      "name": "Leer direcciones",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        360,
        100
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Columna de la hoja con la dirección y tamaño del lote (máximo 1.000 por petición)\nconst COLUMNA = 'direccion';\nconst LOTE = 1000;\n\nconst filas = $input.all()\n  .map((i) => i.json)\n  .filter((r) => String(r[COLUMNA] ?? '').trim() !== '' && String(r.lat ?? '').trim() === '');\n\nconst lotes = [];\nfor (let i = 0; i < filas.length; i += LOTE) {\n  lotes.push({\n    json: {\n      items: filas.slice(i, i + LOTE).map((r) => ({\n        external_id: String(r.row_number),\n        raw_address: String(r[COLUMNA]).trim(),\n      })),\n    },\n  });\n}\nreturn lotes;"
      },
      "id": "cbc406da-91d3-40b2-8a46-30fedd474436",
      "name": "Preparar lotes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://geo.govoy.es/v2/geocode",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ items: $json.items, top_k: 1 }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "fa0a65a2-3761-4405-b29e-6908f0275c85",
      "name": "Geo Govoy · geocode",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Geo Govoy API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Confianza mínima para dar una dirección por buena sin revisarla\nconst UMBRAL = 0.8;\n\nconst salida = [];\nfor (const item of $input.all()) {\n  for (const r of item.json.results ?? []) {\n    const c = (r.candidates ?? [])[0];\n    const confianza = c ? Number(c.confidence_score) : 0;\n    const dudosa = !c || r.next_action !== 'accept' || confianza < UMBRAL;\n    salida.push({\n      json: {\n        row_number: Number(r.external_id),\n        direccion: r.input?.raw_address ?? '',\n        lat: c ? c.lat : '',\n        lon: c ? c.lon : '',\n        estado: r.status,\n        confianza: c ? Math.round(confianza * 1000) / 1000 : '',\n        direccion_normalizada: c ? c.formatted_address : '',\n        siguiente_paso: r.next_action,\n        motivo: (r.warnings ?? []).join(', '),\n        dudosa,\n      },\n    });\n  }\n}\nreturn salida;"
      },
