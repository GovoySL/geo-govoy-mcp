{
  "name": "Geocodificar direcciones de Google Sheets con Geo Govoy",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "",
        "sheetId": "Direcciones",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING",
        "limit": "1000",
        "filter": [
          [
            {
              "a": "A",
              "o": "exist"
            },
            {
              "a": "B",
              "o": "notexist"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Leer direcciones sin lat"
        }
      }
    },
    {
      "id": 2,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": {
        "feeder": 1,
        "rowSeparator": "other",
        "otherRowSeparator": ","
      },
      "mapper": {
        "value": "{\"external_id\":\"{{1.`__ROW_NUMBER__`}}\",\"raw_address\":\"{{replace(replace(1.`0`; /[\\r\\n]+/g; , ); /[\"\\\\]/g; \\$&)}}\"}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Juntar en un lote (JSON)"
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://geo.govoy.es/v2/geocode",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          {
            "name": "X-API-Key",
            "value": "PEGA_AQUI_TU_CLAVE"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\"top_k\":1,\"items\":[{{2.text}}]}",
        "timeout": "120",
        "shareCookies": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Geo Govoy · geocode"
        }
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{3.data.results}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Una dirección cada vez"
        }
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 6,
              "module": "google-sheets:updateRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "",
                "sheetId": "Direcciones",
                "includesHeaders": true,
                "rowNumber": "{{4.external_id}}",
                "valueInputOption": "USER_ENTERED",
                "values": {
                  "1": "{{4.candidates[1].lat}}",
                  "2": "{{4.candidates[1].lon}}",
                  "3": "{{4.status}}",
                  "4": "{{4.candidates[1].confidence_score}}",
                  "5": "{{4.candidates[1].formatted_address}}",
                  "6": "{{4.next_action}}",
                  "7": "{{join(4.warnings; \", \")}}"
                }
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -150,
                  "name": "Escribir resultados"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {
                "__IMTCONN__": null
              },
              "filter": {
                "name": "Dudosa (no accept o confianza < 0,8)",
                "conditions": [
                  [
                    {
                      "a": "{{4.next_action}}",
                      "b": "accept",
                      "o": "text:notequal"
                    }
                  ],
                  [
                    {
                      "a": "{{4.candidates[1].confidence_score}}",
                      "b": "0.8",
                      "o": "number:less"
                    }
                  ]
                ]
              },
              "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "",
                "sheetId": "Dudosas",
                "includesHeaders": true,
                "insertUnformatted": false,
                "valueInputOption": "USER_ENTERED",
                "insertDataOption": "INSERT_ROWS",
                "values": {
                  "0": "{{4.input.raw_address}}",
                  "1": "{{4.candidates[1].lat}}",
                  "2": "{{4.candidates[1].lon}}",
                  "3": "{{4.status}}",
                  "4": "{{4.candidates[1].confidence_score}}",
                  "5": "{{4.candidates[1].formatted_address}}",
                  "6": "{{4.next_action}}",
                  "7": "{{join(4.warnings; \", \")}}"
                }
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 150,
                  "name": "Copiar a Dudosas"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu1.make.com"
  }
}