            "url": {
              "raw": "{{baseUrl}}/v1/uso?mes=2026-11",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "uso"
              ],
              "query": [
                {
                  "key": "mes",
                  "value": "2026-11"
                }
              ]
